# 每 60 秒发一次 SSH keepalive
# 连续 10 次失败才认为断线
Host *
	ServerAliveInterval 60
	ServerAliveCountMax 10
	TCPKeepAlive yes

# `ssh-keygen -t ed25519 -a 300 -C "<email>"`       首选
# 然后将 pubkey 传到 github/gitlab

# `ssh -vT git@github.com`  # NOTE: test connection first
Host github.com
	HostName github.com
	Port 22
	User git
	IdentityFile ~/.ssh/git_keys/github_ed25519.pub
	IdentitiesOnly yes
	UserKnownHostsFile ~/.ssh/git_keys/github.host

# `ssh -vT git@gitlab.com`  # NOTE: test connection first
Host gitlab.com
	HostName gitlab.com
	Port 22
	User git
	IdentityFile ~/.ssh/git_keys/gitlab_ed25519.pub
	IdentitiesOnly yes
	UserKnownHostsFile ~/.ssh/git_keys/gitlab.host

# `ssh -vT foo@bar.com` OR `ssh -vT bar@12.345.678.90`
# 也可以用于 ssh 远程登录. 以下相当于 `ssh bar@foo -i ~/.ssh/config_test/mygitlab -p 10022`
#Host foo   ## 自定义名字(可以是任意值)
	### 服务器真实 ip 地址/域名
	#HostName 12.345.678.90
	#
	### ssh 端口, 默认是 22
	#Port 10022
	#
	### 用户名, "git" 用户只用于 github/gitlab 账户
	#User bar
	#
	### 私钥, 公钥(配合 ssh-agent)
	#IdentityFile ~/.ssh/config_test/mygitlab
	#
	### 只尝试指定的 IdentityFile, 不要把 ssh-agent 里的所有 key 都拿去试
	### 配合 IdentityFile 公钥, 可以让 `ssh-agent` 精准找到对应的私钥. `ssh-add -L` 查看已加载私钥
	#IdentitiesOnly yes
	#
	### 指定储存登录指纹的文件, 默认保存在 ~/.ssh/known_hosts
	#UserKnownHostsFile ~/.ssh/config_test/mygitlab.host

